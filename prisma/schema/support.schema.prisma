// -----------------------------------------------------------------------------
// CUSTOMER SUPPORT
// -----------------------------------------------------------------------------

model SupportTicket {
  id           String              @id @default(uuid()) @db.Uuid
  ticketNumber String              @unique @db.VarChar(40)
  customerId   String              @db.Uuid
  assigneeId   String?             @db.Uuid
  subject      String
  status       SupportTicketStatus @default(OPEN)
  priority     SupportPriority     @default(NORMAL)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)
  closedAt     DateTime?           @db.Timestamptz(6)

  customer User             @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignee User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([customerId, createdAt])
  @@index([assigneeId, status])
  @@index([status, priority, createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id          String            @id @default(uuid()) @db.Uuid
  ticketId    String            @db.Uuid
  senderId    String?           @db.Uuid
  senderType  SupportSenderType
  message     String
  attachments Json?
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
