// -----------------------------------------------------------------------------
// PAYMENTS & REFUNDS
// -----------------------------------------------------------------------------

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @db.Uuid
  provider          PaymentProvider
  method            PaymentMethod
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("BDT") @db.Char(3)
  providerReference String?         @unique @db.VarChar(180)
  idempotencyKey    String?         @unique @db.VarChar(180)
  gatewaySessionId  String?         @db.VarChar(180)
  failureCode       String?
  failureMessage    String?
  paidAt            DateTime?       @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions  PaymentTransaction[]
  webhookEvents PaymentWebhookEvent[]
  refunds       Refund[]

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([provider, gatewaySessionId])
  @@map("payments")
}

model PaymentTransaction {
  id                    String                 @id @default(uuid()) @db.Uuid
  paymentId             String                 @db.Uuid
  type                  PaymentTransactionType
  status                PaymentStatus
  amount                Decimal                @db.Decimal(12, 2)
  currency              String                 @default("BDT") @db.Char(3)
  providerTransactionId String?                @unique @db.VarChar(180)
  responseCode          String?
  responseMessage       String?
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  id                  String          @id @default(uuid()) @db.Uuid
  paymentId           String?         @db.Uuid
  provider            PaymentProvider
  eventId             String          @db.VarChar(200)
  eventType           String          @db.VarChar(120)
  payload             Json
  signatureVerifiedAt DateTime?       @db.Timestamptz(6)
  processedAt         DateTime?       @db.Timestamptz(6)
  processingError     String?
  receivedAt          DateTime        @default(now()) @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([processedAt, receivedAt])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @db.Uuid
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("BDT") @db.Char(3)
  status           RefundStatus @default(PENDING)
  reason           String?
  providerRefundId String?      @unique @db.VarChar(180)
  processedAt      DateTime?    @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
  @@map("refunds")
}
