// -----------------------------------------------------------------------------
// INVENTORY & WAREHOUSES
// -----------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  code      String   @unique @db.VarChar(40)
  address   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  inventory    Inventory[]
  movements    StockMovement[]
  reservations StockReservation[]

  @@map("warehouses")
}

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  warehouseId       String   @db.Uuid
  variantId         String   @db.Uuid
  onHand            Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@map("inventory")
}

model StockMovement {
  id            String                @id @default(uuid()) @db.Uuid
  warehouseId   String                @db.Uuid
  variantId     String                @db.Uuid
  actorId       String?               @db.Uuid
  type          InventoryMovementType
  quantity      Int
  beforeOnHand  Int
  afterOnHand   Int
  referenceType String?               @db.VarChar(60)
  referenceId   String?               @db.Uuid
  note          String?
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor     User?          @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  warehouseId String            @db.Uuid
  variantId   String            @db.Uuid
  orderId     String?           @db.Uuid
  quantity    Int
  status      ReservationStatus @default(RESERVED)
  expiresAt   DateTime          @db.Timestamptz(6)
  releasedAt  DateTime?         @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([orderId])
  @@index([variantId, warehouseId])
  @@map("stock_reservations")
}
